# Copy to .env and fill in. .env is never committed.
#
# Customers' Unleashed API keys are NOT set here: each site's keys are
# entered in the admin console (/admin) and stored encrypted in the database.

# --- Encryption of customers' Unleashed API keys (required in production) ---
# 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep a copy somewhere safe: without it the stored API keys can't be read.
MASTER_KEY=

# --- Database ---
# Production (docker compose sets DATABASE_URL from these):
POSTGRES_PASSWORD=
# Local dev: leave DATABASE_URL unset to use the built-in PGlite database
# in ./.data/pglite — no Postgres install needed.
# DATABASE_URL=postgres://hub:password@localhost:5432/hub

# --- Unleashed sync ---
# Minutes between automatic syncs of every site (BOMs, batches, stock). 0 = off.
UNLEASHED_SYNC_MINUTES=60

# --- HTTPS (production) ---
# The domain pointing at the server. Caddy gets a Let's Encrypt certificate
# for it automatically.
SITE_DOMAIN=

# Production Person Email for assembly exports (becomes a per-site setting).
PRODUCTION_EMAIL=

# Local dev only: the port to listen on (default 3000).
# PORT=3001
