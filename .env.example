# Copy to .env and fill in. .env is never committed.

# --- Web login for the production team (required in production) ---
APP_USER=production
APP_PASSWORD=

# --- Database ---
# Production (docker compose sets DATABASE_URL from these):
POSTGRES_PASSWORD=
# Local dev: leave DATABASE_URL unset to use the built-in PGlite database
# in ./.data/pglite — no Postgres install needed.
# DATABASE_URL=postgres://hub:password@localhost:5432/hub

# --- Unleashed API (Unleashed > Integration > Unleashed API Access) ---
UNLEASHED_API_ID=
UNLEASHED_API_KEY=
# Minutes between automatic BOM / batch-stock syncs. 0 turns it off.
UNLEASHED_SYNC_MINUTES=60

# --- HTTPS (production) ---
# The domain pointing at the VPS, e.g. production.mountainfalls.co.za.
# Caddy gets a Let's Encrypt certificate for it automatically.
SITE_DOMAIN=

# Goes in the Production Person Email column of the schedule exports.
PRODUCTION_EMAIL=nicolette@mountainfalls.co.za
